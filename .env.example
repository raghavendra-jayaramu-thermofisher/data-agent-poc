# Host bindings. Keep BIND_ADDRESS on loopback when a host-level reverse proxy is used.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
API_PORT=8000

# Public browser URL used in password-reset emails.
PASSWORD_RESET_URL_BASE=http://localhost:8080/reset-password

# Container-managed PostgreSQL. Use a URL-safe password if overriding the generated URL.
POSTGRES_DB=dbassistant
POSTGRES_USER=dbassistant
POSTGRES_PASSWORD=dbassistant
CONTAINER_DATABASE_URL=postgresql+asyncpg://dbassistant:dbassistant@postgres:5432/dbassistant

# Application configuration. Development defaults allow an immediate local startup.
APP_ENV=development
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
JWT_SECRET=replace-with-at-least-32-random-characters

# Replace this key before production and preserve it for the lifetime of encrypted data.
SECRET_ENCRYPTION_CURRENT_VERSION=v1
SECRET_ENCRYPTION_KEYS={"v1":"IKDwaOIvGQ2d1pLXE8RAauWa7Cw3j8yL_XOYe-dfy9c="}

# Email Delivery Configuration (console prints reset links to logs; use smtp for production)
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Model provider & analytical agent limits
MODEL_PROVIDER_TIMEOUT_SECONDS=60
AGENT_JOB_TIMEOUT_SECONDS=300
AGENT_MAX_TOOL_CALLS=150
AGENT_MAX_SQL_ATTEMPTS=150
AGENT_QUERY_TIMEOUT_SECONDS=60
AGENT_RESULT_MAX_ROWS=10000
AGENT_RESULT_MAX_BYTES=10000000
AGENT_MODEL_RESULT_MAX_ROWS=500
AGENT_MODEL_RESULT_MAX_BYTES=1000000
AGENT_CHART_MAX_ROWS=2000
AGENT_MAX_HISTORY_MESSAGES=50

