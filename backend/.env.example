APP_ENV=development
APP_NAME=DB Assistant API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://dbassistant:dbassistant@localhost:12202/dbassistant
REDIS_URL=redis://localhost:12203/0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
REDIS_JOB_STREAM=dbassistant:jobs
REDIS_JOB_GROUP=dbassistant-workers
WORKER_ID=
WORKER_BLOCK_MS=5000
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=20
WORKER_STALE_IDLE_MS=60000
JOB_MAX_ATTEMPTS=3
CORS_ORIGINS=["http://localhost:12200","http://127.0.0.1:12200"]
LOG_LEVEL=INFO
PASSWORD_RESET_URL_BASE=http://localhost:12200/reset-password
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Task 2 local datasource storage and credential encryption
DATA_DIRECTORY=./runtime-data
MAX_EXCEL_UPLOAD_BYTES=104857600
EXCEL_BATCH_SIZE=2000
DATASOURCE_OPERATION_TIMEOUT_SECONDS=60
DATASOURCE_QUERY_MAX_ROWS=10000
# Generate a new 32-byte URL-safe base64 key before production. This example is development-only.
SECRET_ENCRYPTION_CURRENT_VERSION=v1
SECRET_ENCRYPTION_KEYS={"v1":"IKDwaOIvGQ2d1pLXE8RAauWa7Cw3j8yL_XOYe-dfy9c="}


# OpenAI-compatible model provider
MODEL_PROVIDER_TIMEOUT_SECONDS=60

# Task 5 analytical agent
AGENT_JOB_TIMEOUT_SECONDS=300
AGENT_MAX_TOOL_CALLS=150
AGENT_MAX_SQL_ATTEMPTS=150
AGENT_QUERY_TIMEOUT_SECONDS=60
AGENT_RESULT_MAX_ROWS=50000
AGENT_RESULT_MAX_BYTES=30000000
AGENT_MODEL_RESULT_MAX_ROWS=200
AGENT_MODEL_RESULT_MAX_BYTES=32768
AGENT_CHART_MAX_ROWS=2000
AGENT_MATRIX_ENABLED=true
AGENT_MATRIX_MAX_NODES=5000
AGENT_MATRIX_MAX_COLUMNS=100
AGENT_MATRIX_MAX_CELLS=100000
AGENT_HTML_ARTIFACT_MAX_BYTES=262144
AGENT_MAX_HISTORY_MESSAGES=50

FINAL_ANSWER_TIMEOUT_SECONDS=60
ANALYSIS_EVIDENCE_RETRIES=2

